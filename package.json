{
  "name": "@don-erfan/auto-skeleton",
  "version": "1.0.0",
  "description": "Zero-config skeleton loaders for React. Wrap any component and get a shimmer skeleton generated from its real DOM: same size, same shape, no hand-written <Skeleton /> components.",
  "keywords": [
    "react",
    "skeleton",
    "skeleton-loader",
    "auto-skeleton",
    "shimmer",
    "placeholder",
    "loading",
    "loader",
    "content-loader",
    "typescript"
  ],
  "author": "don-erfan (https://www.npmjs.com/~don-erfan)",
  "license": "MIT",
  "homepage": "https://github.com/Don-Erfan/auto-skeleton#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Don-Erfan/auto-skeleton.git"
  },
  "bugs": {
    "url": "https://github.com/Don-Erfan/auto-skeleton/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/preview.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=16.14.0"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
